@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Registrarse</h1>
</div>
<form action="@Url.Action("registrarJugador", "Home")" method="post">
Nombre de usuario <input type="text" name="nombreUsuario" id = "nombreUsuario"/>
Contraseña <input type="password" name="contraseña" id = "contraseña"/>

<input type="submit" value="registrarse">
</form>
<p>@ViewBag.Mensaje</p>

<p>¿Ya tienes una cuenta? <a href="@Url.Action("Login", "Home")">Inicia sesión</a></p>

<p id = "mensajeError"></p>
