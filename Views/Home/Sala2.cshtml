        <div>
            <p>Lograste pasar a la siguiente sala!</p>
            <p>Ahora te das cuenta de que cambiaste de videojuego</p>
        </div>
    

    <h2>Cuales son los pokemon que aparecen en las imagenes?</h2>
        <img src=/imagenes/pikachu.jfif alt="pikachu">
        <img src=/imagenes/charmander.jfif alt="charmander">
        <img src=/imagenes/bulbasaur.png alt="bulbasaur">
    <form action="@Url.Action("Sala3", "Home")" method="post" onsubmit="return comprobarRespuesta2()">
    Respuesta: <input type="text" name="respuesta" id = "respuestaSala2"/>
