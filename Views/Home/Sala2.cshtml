    </form>
    <input type="submit" value="Pista" onclick="pistaSala2()">

    <p class ="pista" id = "pista2"></p>

    <p class = "mensajeError" id = "mensajeError2"></p>

    <form action="@Url.Action("Logout", "Home")" method="post">
        <input type="submit" value="Cerrar sesión">
    </form>
    
